#errorCatcher Echo
#encoding UTF-8
#set global $ecw_root = "."
#set global $ecw_charts = True

<!DOCTYPE html>
<html lang="$lang">
  <head>
    <meta charset="UTF-8">
    <title>$station.location</title>
    #if $station.station_url
    <link rel="canonical" href="$station.station_url/$filename" />
    #end if
    #include "head.inc"
    <script>
    /* Initialize as soon as the DOM is ready (does not wait for slow images/iframes). */
    (function initWhenDomReady() {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => setup(), {once: true});
        } else {
            setup();
        }
    })();
    </script>

    #include "analytics.inc"
  </head>

  <body>
    #include "titlebar.inc"

    <div id="contents">
      <div id="widget_group">
        #include "current.inc"
        #include "sunmoon.inc"
        #include "hilo.inc"
        #include "sensors.inc"
        #include "about.inc"
        #include "radar.inc"
        #include "satellite.inc"
        #include "map.inc"
      </div>

      <div id="plot_group">
        <div id="history_widget" class="widget">
          <div id="plot_title" class="widget_title">$gettext("History"):&nbsp;&nbsp;
            <a class="button_selected" id="button_history_day"
               onclick="choose_history('day')">$gettext("Day")</a>
            <a class="button" id="button_history_week"
               onclick="choose_history('week')">$gettext("Week")</a>
            <a class="button" id="button_history_month"
               onclick="choose_history('month')">$gettext("Month")</a>
            <a class="button" id="button_history_year"
               onclick="choose_history('year')">$gettext("Year")</a>
            #if str($Extras.get("chart_builder_enabled", "1")) == "1"
            <a class="widget_control" href="chart-builder/" title="$obs.label.nav_chart_builder">$obs.label.nav_chart_builder</a>
            #end if
          </div>

#for $period in ['day', 'week', 'month', 'year']
          ## The charts of the [$period] group of charts.conf, drawn the first time the period is shown
          <div id="history_${period}" class="plot_container" data-chart-prefix="" style="display:none"></div>
#end for
          <noscript><p class="wx-empty">$obs.label.live_noscript</p></noscript>
        </div>
      </div>
    </div>

    <p class="footnote">
      $gettext("This station is controlled by <a href='https://weewx.com'>WeeWX</a>, an experimental weather software system written in Python.")
      &middot; $obs.label.footer_text
    </p>

  </body>

</html>
